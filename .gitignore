wandb
wandb/
/home/shahriar/inverseProblems/wandb
run-*
.vscode/

# Ignore all .log files
*.log

# Ignore node_modules directory
node_modules/

# Ignore environment variable files
.env
.venv/
# ignore saved models
checkpoints/
checkpoints/noMetaData

# To stop models from being uploaded
*.pth
# ...except the selected checkpoints of study runs (~120 KB each): without the weights,
# reproducing or fine-tuning a result costs a full retrain.
!runs/**/model.pth
!runs/**/model_last.pth

# Ignore Python bytecode and cache directories
src/__pycache__/
__pycache__
*.pyc
__pycache__/
# Downloaded datasets (rebuild with: python src/data_prep.py) -- EXCEPT the three
# prepared files the loaders actually read, which are committed so a fresh clone can
# train without running data_prep at all. Git cannot re-include below an excluded
# directory, hence the level-by-level dance.
data/*
!data/temporal_data/
data/temporal_data/*
!data/temporal_data/METRLA/
data/temporal_data/METRLA/*
!data/temporal_data/METRLA/adj_mat.npy
!data/temporal_data/METRLA/node_values.npy
!data/temporal_data/CPOX/
data/temporal_data/CPOX/*
!data/temporal_data/CPOX/chickenpox.json
    
