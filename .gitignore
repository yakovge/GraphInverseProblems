!runs/**/model.pth
!runs/**/model_last.pth

# Ignore Python bytecode and cache directories
src/__pycache__/
__pycache__
*.pyc
__pycache__/
# Downloaded datasets (rebuild with: python src/data_prep.py)
data/
    
